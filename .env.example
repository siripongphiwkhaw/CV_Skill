# Supabase project API (safe to expose client-side; RLS enforces access control)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Service role key (server-only, never expose client-side, bypasses RLS) —
# needed for the one-time bcrypt password-hash import when migrating existing
# users, and for the Admin API generally.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# JWKS endpoint, for verifying Supabase auth JWTs server-side (e.g. in
# proxy.ts/middleware on the Edge runtime) without a network round trip per request.
SUPABASE_JWKS_URL="https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json"

# Postgres connection string (Supabase pooled connection, port 6543, pgbouncer=true).
DATABASE_URL="postgresql://user:password@host:6543/db?sslmode=require&pgbouncer=true"

# Direct (non-pooled) connection string, used by Prisma for migrations. Supabase port 5432.
DIRECT_URL="postgresql://user:password@host:5432/db?sslmode=require"
